{
  "name": "agentgate-control",
  "version": "0.7.1",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "build": "node scripts/build.mjs",
    "build:purpose": "node scripts/build-purpose.mjs",
    "test:purpose-browser": "npm run demo:flow",
    "build:pages": "node scripts/build-pages.mjs",
    "build:trial": "npm run build && node scripts/build-trial.mjs",
    "dev": "node scripts/dev.mjs",
    "deploy": "npm run build && wrangler deploy",
    "test": "node --test tests/*.test.mjs",
    "mcp": "node mcp/server.mjs",
    "isolated": "node scripts/isolated-agent.mjs",
    "bundle:api": "npm run build && node scripts/bundle.mjs",
    "demos": "python3 -m http.server 8080 --bind 127.0.0.1 --directory demos",
    "check": "npm run build && npm run check:source && npm run test:contract && npm test && wrangler deploy --dry-run",
    "test:login-sync": "npm run build && node --test tests/login-sync.test.mjs && node tests/login-sync-browser.mjs && node tests/login-sync-apps-browser.mjs && node tests/login-sync-routes.mjs",
    "test:ui": "npm run build && node tests/app-ui-browser.mjs",
    "test:hosted": "node tests/hosted-live.mjs",
    "test:hosted-purpose": "node tests/hosted-live.mjs --purpose",
    "upload:hosted-model": "node scripts/upload-hosted-model.mjs",
    "demo:flow": "node scripts/run-flow.mjs",
    "api:generate": "node scripts/api-schema.mjs",
    "test:contract": "node scripts/api-schema.mjs --check",
    "test:flow": "node scripts/demo-flow.mjs",
    "check:source": "node scripts/check-source.mjs"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "2.0.0",
    "@cloudflare/workers-oauth-provider": "^1.2.1",
    "@huggingface/tokenizers": "0.2.0",
    "@modelcontextprotocol/sdk": "1.32.0",
    "onnxruntime-web": "1.30.0",
    "qrcode": "^1.5.4",
    "undici": "^7.30.0",
    "zod": "^3.25.76",
    "@cloudflare/playwright": "^1.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "esbuild": "^0.28.1",
    "wrangler": "4.147.0"
  }
}
