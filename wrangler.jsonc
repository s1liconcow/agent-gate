{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agentgate-control", "main": "src/worker.mjs",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {"ADMIN_ACCOUNT_ID": "owner"},
  "browser": {"binding": "BROWSER"},
  "assets": {"directory": "./public", "binding": "ASSETS", "html_handling": "none", "run_worker_first": ["/api/*", "/hosted-inference.html"]},
  "kv_namespaces": [{"binding": "OAUTH_KV", "id": "c3b893dffeb3448f93313301722dbd2b"}],
  "r2_buckets": [{"binding": "HOSTED_MODELS", "bucket_name": "agentgate-hosted-models"}],
  "durable_objects": {"code_update_strategy": {"mode": "immediate"}, "bindings": [{"name": "GATE", "class_name": "Gate"}, {"name": "REGISTRY", "class_name": "Registry"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["Gate"]}, {"tag": "v2", "new_sqlite_classes": ["Registry"]}],
  "observability": {"logs": {"enabled": true, "invocation_logs": true}}
}
