{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agentgate-control", "main": "src/worker.mjs",
  "compatibility_date": "2026-10-01",
  "assets": {"directory": "./public", "binding": "ASSETS", "html_handling": "none", "run_worker_first": ["/api/*"]},
  "kv_namespaces": [{"binding": "OAUTH_KV", "id": "c3b893dffeb3448f93313301722dbd2b"}],
  "durable_objects": {"bindings": [{"name": "GATE", "class_name": "Gate"}, {"name": "REGISTRY", "class_name": "Registry"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["Gate"]}, {"tag": "v2", "new_sqlite_classes": ["Registry"]}],
  "observability": {"enabled": false}
}
